{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634772+00:00", "entry_type": "phrase", "text": "How you dey?", "translation": "How are you?", "register": "casual"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634791+00:00", "entry_type": "phrase", "text": "How far?", "translation": "What's up? / How is it going?", "register": "casual"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634798+00:00", "entry_type": "phrase", "text": "I dey fine", "translation": "I am fine", "register": "casual"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634803+00:00", "entry_type": "phrase", "text": "Long time no see o", "translation": "It has been a while", "register": "casual"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634808+00:00", "entry_type": "phrase", "text": "Wetin dey happen?", "translation": "What is happening?", "register": "casual"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634812+00:00", "entry_type": "phrase", "text": "Abeg, no vex", "translation": "Please, don't be upset", "register": "neutral"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634816+00:00", "entry_type": "phrase", "text": "No wahala", "translation": "No problem", "register": "casual"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634820+00:00", "entry_type": "phrase", "text": "I wan chop", "translation": "I want to eat", "register": "casual"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634824+00:00", "entry_type": "phrase", "text": "Water don pass garri", "translation": "The situation has become serious", "register": "neutral"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634829+00:00", "entry_type": "phrase", "text": "E don tey wey I see you", "translation": "It has been long since I saw you", "register": "casual"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634833+00:00", "entry_type": "phrase", "text": "Wetin be the price?", "translation": "What is the price?", "register": "neutral"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634837+00:00", "entry_type": "phrase", "text": "Oga, this one too cost", "translation": "Sir, this is too expensive", "register": "neutral"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634841+00:00", "entry_type": "phrase", "text": "Abeg reduce am small", "translation": "Please reduce it a little", "register": "neutral"}
{"lang": "pidgin", "source_doc": "pidgin-starter.txt", "contributor": "praise", "verified": false, "created_at": "2026-07-04T03:56:16.634845+00:00", "entry_type": "phrase", "text": "I go come back", "translation": "I will come back", "register": "neutral"}
