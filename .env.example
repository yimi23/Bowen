# BOWEN environment configuration
# Copy to .env and fill in values. Never commit .env.
# All env reads go through config.py — do not use os.getenv() elsewhere.

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key. Powers every agent brain (Sonnet + Haiku). Hard-required;
# BOWEN refuses to start without it.
ANTHROPIC_API_KEY=

# Praise's personal BOWEN API key (bwn_ prefix). Bootstraps the admin account
# on startup and authenticates the TUI.
ADMIN_API_KEY=

# ── Optional (features degrade gracefully if empty) ───────────────────────────

# Groq API key. Tier-2 routing (LLaMA 3.1 8B) and voice STT (Whisper
# large-v3-turbo). Without it, routing falls back to Haiku and voice STT
# is unavailable.
GROQ_API_KEY=

# Brave Search API key. SCOUT's web_search tool. 1,000 free searches/month.
# Without it, SCOUT cannot search the web.
BRAVE_API_KEY=

# ── GENI (elder-care agent, optional) ─────────────────────────────────────────

# Spawn the supervised GENI Node backend at startup. Default: false.
GENI_ENABLED=

# Shared secret between BOWEN and the GENI backend (internal endpoints +
# GENI device/dashboard auth).
GENI_API_KEY=

# Where the GENI backend listens. Default: http://localhost:5001
GENI_BACKEND_URL=

# Caregiver messaging (used ONLY by core/alert_delivery.py — the gate's
# delivery layer; nothing else in the OS may touch Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_PHONE_NUMBER=

# ── Personalization (all have sensible defaults) ──────────────────────────────

# Display name injected into agent prompts. Default: Praise Oyimi
USER_NAME=

# IANA timezone for scheduler jobs. Default: America/Detroit
USER_TIMEZONE=

# Kokoro TTS voice id. Default: am_adam (deep male)
KOKORO_VOICE=

# Kokoro TTS speaking speed multiplier. Default: 0.95
KOKORO_SPEED=

# ── Not env-configured (for reference, do not add here) ───────────────────────
# Google Calendar/Gmail auth uses credentials.json + token.json files
# (see tools/google_auth.py), not env vars.
# Briefing time (7:00) and Bible check time (6:00) are constants in config.py.
